# Copie este archivo como .env y ajuste los valores. Ningún secreto debe subirse al repositorio.

# --- Pipeline -----------------------------------------------------------------
# Magnitud mínima que se descarga del catálogo del SGC.
SISMONEXO_MIN_MAG=2.5
# Pausa entre solicitudes a los servidores del SGC y del DANE, en segundos (sea considerado).
SISMONEXO_PAUSE=1.5

# --- API ----------------------------------------------------------------------
SISMONEXO_CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080
SISMONEXO_RATE_LIMIT_PER_MINUTE=120
SISMONEXO_MAX_UPLOAD_BYTES=15728640
SISMONEXO_LOG_LEVEL=INFO

# --- Base de datos (arquitectura objetivo, opcional) ---------------------------
POSTGRES_DB=sismonexo
POSTGRES_USER=sismonexo
# Cambie esta contraseña antes de exponer el servicio fuera de su equipo.
POSTGRES_PASSWORD=cambie-esta-clave
SISMONEXO_DATABASE_URL=postgresql://sismonexo:cambie-esta-clave@localhost:5432/sismonexo
